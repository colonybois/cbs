rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    match /site-assets/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.contentType.matches('video/.*')
        && request.resource.size < 30 * 1024 * 1024;
    }
    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /flashback/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /festival-days/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /comity-members/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /payment-proofs/{allPaths=**} {
      allow create: if request.resource.contentType.matches('image/.*')
        && request.resource.size < 850 * 1024;
      allow read, update, delete: if isAdmin();
    }
  }
}
