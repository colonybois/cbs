rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isActive() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isAdmin() {
      return isActive()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      // A new user may read only their own pending profile to learn its status.
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      // Firebase Authentication creates request.auth before this profile is written.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && (request.resource.data.role == 'member' || request.resource.data.role == 'admin')
        && request.resource.data.status == 'pending'
        && (!exists(/databases/$(database)/documents/site_settings/registration)
          || get(/databases/$(database)/documents/site_settings/registration).data.registrationsOpen != false);
      // An active user may update their own profile without altering access state.
      allow update: if isActive()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status;
      allow write: if isAdmin();
    }

    match /online_donations/{donationId} {
      allow create: if request.resource.data.residentName is string
        && request.resource.data.phone is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // Audit entries are append-only. Administrators may inspect them but cannot
    // alter or remove historical records from the client.
    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /chanda_collections/{collectionId} {
      allow create: if isActive()
        && request.resource.data.collectedByUid == request.auth.uid;
      allow read: if isActive()
        && (resource.data.collectedByUid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /donations/{donationId} {
      allow create: if isActive()
        && request.resource.data.collectorId == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow read: if isActive()
        && (resource.data.collectorId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /handovers/{handoverId} {
      allow read, write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /flashback/{flashbackId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_settings/hero {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_settings/registration {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /festival_days/{dayId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
