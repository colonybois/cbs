rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isActive() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isAdmin() {
      return isActive()
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin');
    }

    function isSuperAdmin() {
      return isActive()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    match /users/{userId} {
      // A new user may read only their own pending profile to learn its status.
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      // Firebase Authentication creates request.auth before this profile is written.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.status == 'pending'
        && (
          (!exists(/databases/$(database)/documents/site_settings/registration_config)
            && request.resource.data.role == 'member')
          || (
            exists(/databases/$(database)/documents/site_settings/registration_config)
            && get(/databases/$(database)/documents/site_settings/registration_config).data.isRegistrationOpen != false
            && request.resource.data.role in get(/databases/$(database)/documents/site_settings/registration_config).data.allowedRoles
          )
        );
      // An active user may update their own profile without altering access state.
      allow update: if isActive()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status;
      // Operational admins can review registrations but cannot grant or alter
      // Super Admin access. Super Admin changes go through the Admin SDK API.
      allow update: if isAdmin()
        && resource.data.role != 'super_admin'
        && request.resource.data.role != 'super_admin';
      allow delete: if false;
    }

    match /online_donations/{donationId} {
      allow create: if request.resource.data.residentName is string
        && request.resource.data.donorEmail is string
        && request.resource.data.donorEmail.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.screenshotUrl is string
        && request.resource.data.screenshotUrl.size() > 0
        && request.resource.data.showPublicName == true
        && request.resource.data.status == 'pending';
      // Allow public read of approved donations where donor consented to public display (for Supporters section)
      allow get: if isAdmin() || (resource.data.status == 'approved' && resource.data.showPublicName == true);
      allow list: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // This is a deliberately minimal public projection of approved donations.
    // Full online_donations records remain private because they contain contact
    // and payment information that must never be exposed to visitors.
    match /public_supporters/{supporterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit entries are append-only. Administrators may inspect them but cannot
    // alter or remove historical records from the client.
    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Anonymous page-view events are write-only to visitors; analytics data is
    // visible only to operational admins.
    match /site_visits/{visitId} {
      allow create: if request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() > 0
        && request.resource.data.path is string
        && request.resource.data.path.size() > 0
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /chanda_collections/{collectionId} {
      allow create: if isActive()
        && request.resource.data.collectedByUid == request.auth.uid;
      allow read: if isActive()
        && (resource.data.collectedByUid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /donations/{donationId} {
      // Cash collections need an admin review. Member UPI collections are
      // accepted immediately and therefore cannot be created as pending.
      allow create: if isActive()
        && request.resource.data.collectorId == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && (
          (request.resource.data.paymentMode == 'cash'
            && request.resource.data.status == 'pending_approval')
          ||
          (request.resource.data.paymentMode == 'upi'
            && request.resource.data.status == 'approved')
        );
      // get: member reads their own; admin reads any
      allow get: if isActive()
        && (resource.data.collectorId == request.auth.uid || isAdmin());
      // Firestore evaluates this for every possible result, so member queries
      // must constrain collectorId to their authenticated UID. Admins can list all.
      allow list: if isActive()
        && (resource.data.collectorId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /handovers/{handoverId} {
      allow read, write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /flashback/{flashbackId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_settings/hero {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_settings/registration_config {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_settings/email {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /festival_days/{dayId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /comity_members/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Email logs — admin read-only, written server-side via API route
    // (the API route uses the Firebase client SDK with the admin's auth token)
    match /email_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isActive();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
